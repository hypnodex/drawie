# Copy to `.env.local` and fill in. Restart `npm run dev` after changes.

# Supabase project. Local values come from `npx supabase status` after
# `npx supabase start`; production values come from your hosted project settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-only: show the seeded demo personas on the login screen and auto-impersonate
# one on first load (password 'drawie123'). Leave unset/false in production.
VITE_DEV_IMPERSONATE=true

# Content moderation (OpenAI vision LLM) runs SERVER-SIDE in the `moderate` Edge
# Function — the key is never bundled into the browser. Configure it as a secret:
#   • Local:      supabase/functions/.env  →  OPENAI_API_KEY=sk-...
#   • Production: supabase secrets set OPENAI_API_KEY=sk-...
# Without it, moderation falls back to the on-device nsfwjs + OCR pipeline.
