{
  "name": "drawie-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @drawie/web",
    "build": "npm run build --workspace @drawie/web",
    "preview": "npm run preview --workspace @drawie/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "supabase": "^2.105.0",
    "typescript": "^5.6.0"
  }
}
