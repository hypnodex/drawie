{
  "$schema": "./tokens.schema (informal)",
  "$comment": [
    "CANONICAL design tokens — single source of truth for the shadcn semantic palette.",
    "Values are the WEB brand palette (apps/web/src/index.css :root), resolved through the web's",
    "`@theme inline` shadcn bridge (--color-* -> brand primitive). The web stays OKLCH and is NOT",
    "regenerated from this file (it remains the reference). build.mjs converts each OKLCH value to",
    "HSL channels and writes apps/native/global.css :root, so the SAME `bg-primary` / `text-foreground`",
    "utilities resolve to the SAME color on web and native. To change a color: edit it here + in the web",
    "index.css (kept in sync by hand for now), then `node packages/tokens/build.mjs`.",
    "Each token notes the web --color-* it mirrors and the brand primitive that resolves to."
  ],
  "color": {
    "background":             { "oklch": "oklch(97.02% 0.0026 147.88)", "from": "--color-background -> --background" },
    "foreground":             { "oklch": "oklch(21.03% 0.0026 147.88)", "from": "--color-foreground -> --foreground" },
    "card":                   { "oklch": "oklch(100% 0.0013 147.88)",   "from": "--color-card -> --surface" },
    "card-foreground":        { "oklch": "oklch(21.03% 0.0026 147.88)", "from": "--color-card-foreground -> --surface-foreground" },
    "popover":                { "oklch": "oklch(100% 0.0013 147.88)",   "from": "--color-popover -> --overlay" },
    "popover-foreground":     { "oklch": "oklch(21.03% 0.0026 147.88)", "from": "--color-popover-foreground -> --overlay-foreground" },
    "primary":                { "oklch": "oklch(76.97% 0.2124 147.88)", "from": "--color-primary -> --accent" },
    "primary-foreground":     { "oklch": "oklch(15.00% 0.0030 147.88)", "from": "--color-primary-foreground -> --accent-foreground" },
    "secondary":              { "oklch": "oklch(95.24% 0.0021 147.88)", "from": "--color-secondary -> --surface-secondary" },
    "secondary-foreground":   { "oklch": "oklch(21.03% 0.0026 147.88)", "from": "--color-secondary-foreground -> --surface-secondary-foreground" },
    "muted":                  { "oklch": "oklch(93.73% 0.0021 147.88)", "from": "--color-muted -> --surface-tertiary" },
    "muted-foreground":       { "oklch": "oklch(55.17% 0.0055 147.88)", "from": "--color-muted-foreground -> --muted" },
    "accent":                 { "oklch": "oklch(93.73% 0.0021 147.88)", "from": "--color-accent -> --surface-tertiary" },
    "accent-foreground":      { "oklch": "oklch(21.03% 0.0026 147.88)", "from": "--color-accent-foreground -> --foreground" },
    "destructive":            { "oklch": "oklch(65.32% 0.2344 13.12)",  "from": "--color-destructive -> --danger" },
    "destructive-foreground": { "oklch": "oklch(99.11% 0 0)",           "from": "--color-destructive-foreground -> --danger-foreground" },
    "border":                 { "oklch": "oklch(90.00% 0.0026 147.88)", "from": "--color-border -> --border" },
    "input":                  { "oklch": "oklch(90.00% 0.0026 147.88)", "from": "--color-input -> --border" },
    "ring":                   { "oklch": "oklch(76.97% 0.2124 147.88)", "from": "--color-ring -> --focus" },
    "success":               { "oklch": "oklch(73.29% 0.1948 138.19)", "from": "--color-success -> --success" },
    "success-foreground":    { "oklch": "oklch(21.03% 0.0048 138.19)", "from": "--color-success-foreground -> --success-foreground" },
    "warning":               { "oklch": "oklch(78.19% 0.1596 59.71)",  "from": "--color-warning -> --warning" },
    "warning-foreground":    { "oklch": "oklch(21.03% 0.0048 59.71)",  "from": "--color-warning-foreground -> --warning-foreground" }
  },
  "radius": { "DEFAULT": { "value": "0.5rem", "from": "--radius" } }
}
